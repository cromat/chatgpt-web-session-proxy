{
  "name": "chatgpt-web-session-proxy",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "description": "Experimental session-mode OpenAI-compatible proxy backed by a logged-in ChatGPT web browser session.",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "login": "tsx src/login.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:chrome": "tsx src/server.ts --browser chrome",
    "dev:chrome:auto": "tsx src/server.ts --browser chrome --runtime-mode auto",
    "dev:chrome:virtual": "tsx src/server.ts --browser chrome --runtime-mode virtual",
    "dev:chrome:hidden": "tsx src/server.ts --browser chrome --runtime-mode hidden",
    "dev:chrome:headed": "tsx src/server.ts --browser chrome --runtime-mode headed",
    "dev:chrome:headless": "tsx src/server.ts --browser chrome --runtime-mode headless",
    "login:chrome": "tsx src/login.ts --browser chrome",
    "start:chrome": "node dist/src/server.js --browser chrome",
    "start:chrome:auto": "node dist/src/server.js --browser chrome --runtime-mode auto",
    "start:chrome:virtual": "node dist/src/server.js --browser chrome --runtime-mode virtual",
    "start:chrome:hidden": "node dist/src/server.js --browser chrome --runtime-mode hidden",
    "dev:chromium": "tsx src/server.ts --browser chromium",
    "login:chromium": "tsx src/login.ts --browser chromium",
    "start:chromium": "node dist/src/server.js --browser chromium"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
